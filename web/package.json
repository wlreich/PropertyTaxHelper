{
  "name": "property-tax-helper-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --conditions=react-server --test tests/*.test.mjs",
    "brand:check": "node scripts/check-brand.mjs",
    "format:check": "node scripts/check-format.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run guide:check && npm run guide:pdf:check && npm run format:check && npm run brand:check && npm run lint && npm test && npm run build && npm run typecheck",
    "test:brand-browser": "playwright test --config=playwright.brand.config.ts",
    "test:home": "playwright test --config=playwright.home.config.ts",
    "test:home:smoke": "playwright test --config=playwright.smoke.config.ts",
    "brand:visual": "BRAND_VISUAL_COMPARE=1 playwright test --config=playwright.brand.config.ts",
    "brand:visual:update": "BRAND_VISUAL_COMPARE=1 playwright test --config=playwright.brand.config.ts --update-snapshots",
    "guide:generate": "node scripts/generate-protest-guide.mjs",
    "guide:check": "node scripts/generate-protest-guide.mjs --check",
    "guide:pdf": "python3 scripts/generate-guide-pdf.py",
    "guide:pdf:check": "node scripts/check-guide-pdf.mjs",
    "test:guide-browser": "playwright test --config=playwright.guide.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
